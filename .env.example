# Server-side only. Never prefixed with VITE_ — these must not leak into the
# frontend bundle.

# Shared password for the team. Used as the invite-gate password in
# /api/auth/signup and /api/auth/resend-invite.
SHARED_PASSWORD=your-shared-password-here

# Supabase project URL.
SUPABASE_URL=https://your-project.supabase.co

# Supabase service-role key. ONLY used by api/*.ts in serverless functions
# and by dev-server.ts. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of emails that should get is_admin=true on first
# setup-account. Case-insensitive.
ADMIN_EMAILS=admin@example.com

# Public-facing site origin, used as base for invite-email redirectTo
# (/auth/callback). Falls back to VERCEL_URL for preview deployments.
SITE_URL=https://prompt-workbench-three.vercel.app


# Frontend-visible. Must have the VITE_ prefix — Vite only inlines variables
# with this prefix into the client bundle. These are safe to expose (spec
# §13 "anon key exposure: necessary").

# Frontend API base URL. Empty for local dev (Vite proxies /api -> 3001),
# empty for production (Vercel handles routing).
VITE_API_BASE_URL=

# Same Supabase project URL as SUPABASE_URL above.
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon / publishable key (sb_publishable_...). Used by the browser
# to receive the invite access_token via the /auth/callback fragment and
# call setSession. Public by design.
VITE_SUPABASE_ANON_KEY=sb_publishable_your-anon-key
