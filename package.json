{
  "name": "prompt-workbench",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:logs": "if grep -rE 'console\\.(log|info|warn|error)\\(req\\.(body|headers|query)|console\\.(log|info|warn|error)\\([^)]*messages\\b' api/ src/lib/api.ts dev-server.ts; then echo 'Forbidden raw log of request data'; exit 1; fi",
    "lint:env": "node scripts/lint-env.mjs",
    "typecheck": "tsc -b tsconfig.app.json tsconfig.node.json api/tsconfig.json tests/tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "start": "node --import tsx/esm server.ts"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/supabase-js": "^2.105.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/express": "^5.0.6",
    "@vercel/node": "^5.7.13",
    "express": "^5.2.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "tsx": "^4.21.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.12",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vercel": "^52.2.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
